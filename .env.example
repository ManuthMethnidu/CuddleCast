# 1. Catalog & Metadata API (TMDB API v3)
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_ORIGINAL=https://image.tmdb.org/t/p/original
VITE_TMDB_IMAGE_W500=https://image.tmdb.org/t/p/w500

# 2. Authentication, Profiles, Watchlist & Playback Sync (Supabase)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Video Streaming Engine (HLS .m3u8 / Mux / Cloudflare Stream)
VITE_DEFAULT_HLS_STREAM=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
VITE_FALLBACK_TRAILER_HLS=https://test-streams.mux.dev/pts_shift/master.m3u8

# 4. Runtime Mode ("live" uses TMDB/Supabase, "mock" uses REA capturedPayloads.json)
VITE_DATA_MODE=auto
