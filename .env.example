# ==============================================================================
# ECHORA - VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Private Server-Side Secret (Enter as "Secret" on Vercel - NEVER exposed to browser)
# The Vercel serverless proxy (/api/tmdb) uses this securely on the backend.
TMDB_API_KEY=your_tmdb_api_key_here

# 2. Public Frontend Image CDNs (Config in Vercel)
VITE_TMDB_IMAGE_ORIGINAL=https://image.tmdb.org/t/p/original
VITE_TMDB_IMAGE_W500=https://image.tmdb.org/t/p/w500

# 3. Clerk Authentication (Application app_3LGvQKNKQ5CvSlC391y2TL39XFS)
# Obtain your Publishable Key from Clerk Dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# 4. Stream Playback & Fallbacks (HLS .m3u8)
VITE_DEFAULT_HLS_STREAM=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
VITE_FALLBACK_TRAILER_HLS=https://test-streams.mux.dev/pts_shift/master.m3u8

# 5. Stream Security & Signed Token Edge Middleware
VITE_STREAM_SIGNING_SECRET=echora-edge-token-super-secret-key-change-me

# 6. Data Mode ("auto" uses live APIs when credentials are present, fallback when offline)
VITE_DATA_MODE=auto
